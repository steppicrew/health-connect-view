# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Create the keystore with: ./scripts/make-keystore.sh

# Absolute path to the release keystore. Keep it OUTSIDE this repo.
KEYSTORE_PATH=/home/your-user/.android-keys/health-connect-view.keystore

# Passwords chosen when the keystore was created.
KEYSTORE_PASSWORD=your-keystore-password
KEY_PASSWORD=your-key-password

# Key alias inside the keystore.
KEY_ALIAS=health-connect-view

# Google Play service account JSON, for automated uploads. Leave blank until
# a service account exists in the Play Console.
PLAY_SERVICE_ACCOUNT_JSON=

# Local directory published as the project website. `./scripts/sync-privacy.sh` writes the
# generated privacy page here. Leave blank to only build it into build/privacy.
PRIVACY_SYNC_DIR=
