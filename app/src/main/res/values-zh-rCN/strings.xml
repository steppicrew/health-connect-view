    <!-- Privacy policy. Every claim here must stay true of the shipped build. -->
    <string name="privacy_title">隐私</string>
    <string name="privacy_summary">此应用向您显示 Health Connect 已存储在您设备上的健康数据。它是一个查看器：只读取和显示。唯一的例外是您自己启动的导出。</string>
    <string name="privacy_no_network_title">您的数据永远不会离开您的设备</string>
    <string name="privacy_no_network_body">此应用完全没有联网权限。这不是我们对自身行为的承诺，而是 Android 本身阻止此应用建立任何网络连接。没有可以发送您数据的服务器，也没有任何分析、跟踪或广告代码。</string>
    <string name="privacy_read_only_title">只读访问</string>
    <string name="privacy_read_only_body">只请求读取权限，因此此应用无法更改或删除您的健康记录。允许哪些数据类型由您逐一选择，默认不选中任何项。</string>
    <string name="privacy_storage_title">此应用不存储任何内容</string>
    <string name="privacy_storage_body">健康数据只在您查看时保存在内存中，此应用绝不会自行将其写入存储空间。唯一的例外是导出：当您要求导出时，文件会写入您在 Android 自带的保存对话框中选择的位置，此应用不保留任何副本。您查看或打印的报告会直接从内存送到 Android 自带的打印预览，之后只会发送到您指定的地方。除此之外，此应用只保存您的显示设置。备份和设备间转移已停用，因此不会有任何内容复制到云端。</string>
    <string name="privacy_sharing_title">不共享</string>
    <string name="privacy_sharing_body">您的健康数据绝不会与任何人共享，包括开发者在内。任何第三方 SDK 都不会接收这些数据。导出的文件归您所有：之后去向由您决定。</string>
    <string name="permission_routes_title">所有锻炼路线</string>
    <string name="permission_routes_body">需在锻炼中允许，而非此处：打开一次有路线的锻炼并点按“%1$s”。Android 询问时选择始终允许，此后所有路线都会直接显示。</string>
    <string name="permission_shared_with">与%1$s一起授予。</string>
    <string name="perm_info_closing">只读：此应用绝不会更改或删除任何内容。除非您自己导出，否则任何内容都不会离开您的设备。</string>
    <string name="perm_info_history">Health Connect 会保留较早的数据，但除非您允许更多，否则只向应用提供最近 30 天的数据。有了此权限，周、四周和年视图、趋势以及报告都能追溯到您数据的最早时间。它改变的是此应用能回看多久，而不是数据的种类。</string>
    <string name="perm_info_routes">路线是您在锻炼期间所处的位置：带时间的位置信息，是 Health Connect 中最敏感的数据。有了此权限，打开锻炼后会立即显示其路线；没有它，Android 每次都会询问您。此应用没有联网权限，因此不带地图绘制路线，且只在您查看时保留。</string>
    <string name="perm_info_active_calories">在身体静息消耗之外，通过运动消耗的能量。以每日总计和随时间变化的形式显示。</string>
    <string name="perm_info_basal_metabolic_rate">身体在静息状态下消耗的能量。Health Connect 通常根据您的身高和体重推算。以每日数值和随时间变化的形式显示。</string>
    <string name="perm_info_exercise">您的锻炼：类型、开始、结束，以及记录应用设置的标题（如果有）；骑行踏频属于同一权限，Health Connect 只会同时授予两者。以锻炼的形式显示，并附上期间测得的心率和其他测量值。锻炼路线是单独的权限。</string>
    <string name="perm_info_distance">步行、骑行或以其他方式移动的距离。以每日总计、随时间变化以及每次锻炼的数据显示。</string>
    <string name="perm_info_elevation_gained">爬升的高度，单位为米。以每日总计、随时间变化以及每次锻炼的数据显示。</string>
    <string name="perm_info_floors_climbed">设备统计的爬楼层数。以对比每日目标和随时间变化的形式显示。</string>
    <string name="perm_info_planned_exercise">在训练应用中提前计划的锻炼。按标题和类型列出。</string>
    <string name="perm_info_power">锻炼时的功率，单位为瓦，例如来自自行车。以带每日范围的随时间变化以及每次锻炼的数据显示。</string>
    <string name="perm_info_speed">移动时的速度。以带每日范围的随时间变化以及每次锻炼的数据显示。</string>
    <string name="perm_info_steps">手机或穿戴设备统计的步数以及您的步频；Health Connect 只会同时授予两者。以对比每日目标、全天变化、带可选 4 周平均值的随时间变化以及每次锻炼的数据显示。</string>
    <string name="perm_info_total_calories">一天中静息和运动时消耗的全部能量。以每日总计和随时间变化的形式显示。</string>
    <string name="perm_info_vo2_max">由您的设备计算的有氧能力估算值。以数值和随时间变化的形式显示。</string>
    <string name="perm_info_wheelchair_pushes">设备统计的轮椅推动次数，相当于步数。以每日总计和随时间变化的形式显示。</string>
    <string name="perm_info_body_fat">体脂百分比，例如来自体重秤。以最新测量值和随时间变化的形式显示。</string>
    <string name="perm_info_body_water_mass">身体中的水分量，来自可测量此项的体重秤。以最新测量值和随时间变化的形式显示。</string>
    <string name="perm_info_bone_mass">骨量，来自可估算此项的体重秤。以最新测量值和随时间变化的形式显示。</string>
    <string name="perm_info_height">您的身高。以最新输入值显示；Health Connect 也会用它估算您的静息能量消耗。</string>
    <string name="perm_info_lean_body_mass">不含体脂的体重，来自可估算此项的体重秤。以最新测量值和随时间变化的形式显示。</string>
    <string name="perm_info_weight">您的称重记录。以最新测量值、带每日范围的随时间变化以及（如果您创建）供医生查看的 PDF 报告显示。</string>
    <string name="perm_info_blood_glucose">您的血糖测量值，以及记录应用保存的与进餐的关系（如果有）。按您的选择以 mmol/L 或 mg/dL、随时间变化以及（如果您创建）按与进餐的关系和目标范围排序的 PDF 报告显示。与此类病症相关的健康数据需要慎重对待；它们会留在您的设备上。</string>
    <string name="perm_info_blood_pressure">您的血压测量值，包括收缩压和舒张压。以分级、早晚平均值、随时间变化以及（如果您创建）供医生查看的 PDF 记录显示。</string>
    <string name="perm_info_body_temperature">用体温计或设备测得的体温。以测量值和随时间变化的形式显示。</string>
    <string name="perm_info_heart_rate">您全天的心率，通常来自穿戴设备，每分钟多次测量。以全天变化、每日范围随时间变化以及每次锻炼的曲线显示。</string>
    <string name="perm_info_heart_rate_variability">心跳间隔的变化，主要在睡眠中测量。以每晚的数值以及对比您平常范围的 7 晚平均值显示。</string>
    <string name="perm_info_oxygen_saturation">血液携带的氧气量百分比，通常在夜间测量。以全天变化以及带各日范围的每日平均值显示。</string>
    <string name="perm_info_respiratory_rate">每分钟呼吸次数，通常由穿戴设备测量。以全天变化以及带各日范围的每日平均值显示。</string>
    <string name="perm_info_resting_heart_rate">您的静息心率，每天一个数值。以当天的数值及其趋势、带可选 4 周平均值的随时间变化以及（如果您创建）PDF 报告显示。</string>
    <string name="perm_info_skin_temperature">您的皮肤温度与平常的差值，由穿戴设备测量，主要在夜间。以该差值随时间变化的形式显示。</string>
    <string name="perm_info_hydration">在应用中记录的饮水量。以每日总计和随时间变化的形式显示。</string>
    <string name="perm_info_nutrition">在应用中记录的餐食及其内容。目前此应用以每日总计和随时间变化的形式显示其能量。</string>
    <string name="perm_info_sleep">您的夜间睡眠：何时入睡，以及设备记录的睡眠阶段（如果有）。以每晚及其阶段、带可选 4 周平均值的每晚睡眠时长随时间变化，以及作为心率变异性状态依据的夜晚显示。</string>
    <string name="perm_info_cervical_mucus">在周期应用中记录的宫颈黏液观察。在周期概览中以及作为条目显示。</string>
    <string name="perm_info_intermenstrual_bleeding">在周期应用中记录的两次经期之间的点滴出血。在周期概览中以及作为条目显示。</string>
    <string name="perm_info_menstruation">您的经期以及每天的经量；Health Connect 只会同时授予两者。在周期概览中以及作为条目显示。周期数据属于个人隐私；它们会留在您的设备上。</string>
    <string name="perm_info_ovulation_test">在周期应用中记录的排卵测试结果。在周期概览中以及作为条目显示。</string>
    <string name="perm_info_basal_body_temperature">您的静息体温，通常在醒来时测量，用于追踪周期。在周期概览中以及随时间变化显示。</string>
    <string name="perm_info_sexual_activity">在周期应用中记录的性活动条目，以及注明的保护措施（如果有）。只作为条目显示，不会出现在其他任何地方。这是最私密的数据之一；它们会留在您的设备上。</string>
    <string name="perm_info_mindfulness">在应用中记录的冥想、呼吸等练习。以带时长的练习以及各天每日时长的形式显示。</string>
